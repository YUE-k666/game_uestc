      "Bash(source /data1/anaconda3/etc/profile.d/conda.sh && conda activate InternAgent && export LANGAGENT_DB_PATH=\"tests/data/autotsf_searchplan_validate/AutoTSF.db\" && export LANGAGENT_VECTOR_DB_PATH=\"tests/data/autotsf_searchplan_validate/vector/AutoTSF\" && export ANTHROPIC_API_KEY=\"sk-da6158a912e346a3bcea50218ede80d0\" && export ANTHROPIC_BASE_URL=\"https://dashscope.aliyuncs.com/apps/anthropic\" && export ANTHROPIC_DEFAULT_HAIKU_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_SONNET_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_OPUS_MODEL=\"qwen3-max\" && python - <<'PY'\nimport asyncio\nimport json\nfrom tests.test_autotsf_full_pipeline import \\(\n    setup_logging,\n    run_baseline_analyzer,\n    run_search_planner,\n    run_parallel_retrievers,\n    run_idea_forge,\n\\)\n\nasync def main\\(\\):\n    setup_logging\\(\\)\n    baseline_result = await run_baseline_analyzer\\(\"AutoTSF\"\\)\n    planner_result = await run_search_planner\\(\n        baseline_result=baseline_result,\n        planning_mode=\"diverse\",\n        previous_analysis=None,\n        iteration=1,\n    \\)\n    search_plans = planner_result.get\\(\"search_plans\", []\\)\n    print\\(\"\\\\n=== SEARCH PLANS ===\"\\)\n    print\\(f\"count={len\\(search_plans\\)}\"\\)\n    type_counts = {}\n    for i, plan in enumerate\\(search_plans, 1\\):\n        type_counts[plan['plan_type']] = type_counts.get\\(plan['plan_type'], 0\\) + 1\n        print\\(f\"[{i}] type={plan['plan_type']}\"\\)\n        print\\(f\"    title={plan['title']}\"\\)\n        print\\(f\"    keywords={plan.get\\('keywords'\\)}\"\\)\n        print\\(f\"    rationale_present={bool\\(\\(plan.get\\('rationale'\\) or ''\\).strip\\(\\)\\)}\"\\)\n    print\\(\"type_counts=\", json.dumps\\(type_counts, ensure_ascii=False\\)\\)\n\n    retrieval_results = await run_parallel_retrievers\\(search_plans, baseline_result.get\\(\"baseline\"\\)\\)\n    print\\(\"\\\\n=== RETRIEVAL SUMMARY ===\"\\)\n    for i, item in enumerate\\(retrieval_results, 1\\):\n        print\\(f\"[{i}] papers={len\\(item.get\\('papers', []\\)\\)} error={item.get\\('error'\\)}\"\\)\n\n    idea_forge_result = await run_idea_forge\\(baseline_result, retrieval_results\\)\n    ideas = idea_forge_result.get\\(\"ideas\", []\\)\n    print\\(\"\\\\n=== IDEAS ===\"\\)\n    print\\(f\"count={len\\(ideas\\)}\"\\)\n    for i, idea in enumerate\\(ideas, 1\\):\n        eval_info = idea.get\\('evaluation'\\) or {}\n        print\\(f\"[{i}] {idea.get\\('title'\\)}\"\\)\n        print\\(f\"    recommendation={eval_info.get\\('recommendation'\\)} overall={eval_info.get\\('overall_score'\\)}\"\\)\n        print\\(f\"    keywords={idea.get\\('keywords'\\)}\"\\)\n        print\\(f\"    referenced_papers={idea.get\\('referenced_papers'\\)}\"\\)\n\nasyncio.run\\(main\\(\\)\\)\nPY)",
      "Bash(source /data1/anaconda3/etc/profile.d/conda.sh && conda activate InternAgent && export LANGAGENT_DB_PATH=\"tests/data/autotsf_searchplan_validate/AutoTSF.db\" && export LANGAGENT_VECTOR_DB_PATH=\"tests/data/autotsf_searchplan_validate/vector/AutoTSF\" && export ANTHROPIC_API_KEY=\"sk-da6158a912e346a3bcea50218ede80d0\" && export ANTHROPIC_BASE_URL=\"https://dashscope.aliyuncs.com/apps/anthropic\" && export ANTHROPIC_DEFAULT_HAIKU_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_SONNET_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_OPUS_MODEL=\"qwen3-max\" && python - <<'PY'\nimport asyncio\nimport json\nimport sys\nfrom pathlib import Path\nsys.path.insert\\(0, str\\(Path\\('/data_8T/gsk/LangAgent_gsk_v5'\\)\\)\\)\nfrom tests.test_autotsf_full_pipeline import \\(\n    setup_logging,\n    run_baseline_analyzer,\n    run_search_planner,\n    run_parallel_retrievers,\n    run_idea_forge,\n\\)\n\nasync def main\\(\\):\n    setup_logging\\(\\)\n    baseline_result = await run_baseline_analyzer\\(\"AutoTSF\"\\)\n    planner_result = await run_search_planner\\(\n        baseline_result=baseline_result,\n        planning_mode=\"diverse\",\n        previous_analysis=None,\n        iteration=1,\n    \\)\n    search_plans = planner_result.get\\(\"search_plans\", []\\)\n    print\\(\"\\\\n=== SEARCH PLANS ===\"\\)\n    print\\(f\"count={len\\(search_plans\\)}\"\\)\n    type_counts = {}\n    for i, plan in enumerate\\(search_plans, 1\\):\n        type_counts[plan['plan_type']] = type_counts.get\\(plan['plan_type'], 0\\) + 1\n        print\\(f\"[{i}] type={plan['plan_type']}\"\\)\n        print\\(f\"    title={plan['title']}\"\\)\n        print\\(f\"    keywords={plan.get\\('keywords'\\)}\"\\)\n        print\\(f\"    rationale_present={bool\\(\\(plan.get\\('rationale'\\) or ''\\).strip\\(\\)\\)}\"\\)\n    print\\(\"type_counts=\", json.dumps\\(type_counts, ensure_ascii=False\\)\\)\n\n    retrieval_results = await run_parallel_retrievers\\(search_plans, baseline_result.get\\(\"baseline\"\\)\\)\n    print\\(\"\\\\n=== RETRIEVAL SUMMARY ===\"\\)\n    for i, item in enumerate\\(retrieval_results, 1\\):\n        print\\(f\"[{i}] papers={len\\(item.get\\('papers', []\\)\\)} error={item.get\\('error'\\)}\"\\)\n\n    idea_forge_result = await run_idea_forge\\(baseline_result, retrieval_results\\)\n    ideas = idea_forge_result.get\\(\"ideas\", []\\)\n    print\\(\"\\\\n=== IDEAS ===\"\\)\n    print\\(f\"count={len\\(ideas\\)}\"\\)\n    for i, idea in enumerate\\(ideas, 1\\):\n        eval_info = idea.get\\('evaluation'\\) or {}\n        print\\(f\"[{i}] {idea.get\\('title'\\)}\"\\)\n        print\\(f\"    recommendation={eval_info.get\\('recommendation'\\)} overall={eval_info.get\\('overall_score'\\)}\"\\)\n        print\\(f\"    keywords={idea.get\\('keywords'\\)}\"\\)\n        print\\(f\"    referenced_papers={idea.get\\('referenced_papers'\\)}\"\\)\n\nasyncio.run\\(main\\(\\)\\)\nPY)",
      "Bash(source /data1/anaconda3/etc/profile.d/conda.sh && conda activate InternAgent && export LANGAGENT_DB_PATH=\"tests/data/autotsf_searchplan_validate/AutoTSF.db\" && export LANGAGENT_VECTOR_DB_PATH=\"tests/data/autotsf_searchplan_validate/vector/AutoTSF\" && export ANTHROPIC_API_KEY=\"sk-da6158a912e346a3bcea50218ede80d0\" && export ANTHROPIC_BASE_URL=\"https://dashscope.aliyuncs.com/apps/anthropic\" && export ANTHROPIC_DEFAULT_HAIKU_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_SONNET_MODEL=\"qwen3-max\" && export ANTHROPIC_DEFAULT_OPUS_MODEL=\"qwen3-max\" && python - <<'PY'\nimport asyncio\nimport importlib.util\nimport json\nfrom pathlib import Path\n\nmodule_path = Path\\('/data_8T/gsk/LangAgent_gsk_v5/tests/test_autotsf_full_pipeline.py'\\)\nspec = importlib.util.spec_from_file_location\\('test_autotsf_full_pipeline', module_path\\)\nmodule = importlib.util.module_from_spec\\(spec\\)\nspec.loader.exec_module\\(module\\)\n\nasync def main\\(\\):\n    module.setup_logging\\(\\)\n    baseline_result = await module.run_baseline_analyzer\\('AutoTSF'\\)\n    planner_result = await module.run_search_planner\\(\n        baseline_result=baseline_result,\n        planning_mode='diverse',\n        previous_analysis=None,\n        iteration=1,\n    \\)\n    search_plans = planner_result.get\\('search_plans', []\\)\n    print\\('\\\\n=== SEARCH PLANS ==='\\)\n    print\\(f'count={len\\(search_plans\\)}'\\)\n    type_counts = {}\n    for i, plan in enumerate\\(search_plans, 1\\):\n        type_counts[plan['plan_type']] = type_counts.get\\(plan['plan_type'], 0\\) + 1\n        print\\(f'[{i}] type={plan[\"plan_type\"]}'\\)\n        print\\(f'    title={plan[\"title\"]}'\\)\n        print\\(f'    keywords={plan.get\\(\"keywords\"\\)}'\\)\n        print\\(f'    rationale_present={bool\\(\\(plan.get\\(\"rationale\"\\) or \"\"\\).strip\\(\\)\\)}'\\)\n    print\\('type_counts=', json.dumps\\(type_counts, ensure_ascii=False\\)\\)\n\n    retrieval_results = await module.run_parallel_retrievers\\(search_plans, baseline_result.get\\('baseline'\\)\\)\n    print\\('\\\\n=== RETRIEVAL SUMMARY ==='\\)\n    for i, item in enumerate\\(retrieval_results, 1\\):\n        print\\(f'[{i}] papers={len\\(item.get\\(\"papers\", []\\)\\)} error={item.get\\(\"error\"\\)}'\\)\n\n    idea_forge_result = await module.run_idea_forge\\(baseline_result, retrieval_results\\)\n    ideas = idea_forge_result.get\\('ideas', []\\)\n    print\\('\\\\n=== IDEAS ==='\\)\n    print\\(f'count={len\\(ideas\\)}'\\)\n    for i, idea in enumerate\\(ideas, 1\\):\n        eval_info = idea.get\\('evaluation'\\) or {}\n        print\\(f'[{i}] {idea.get\\(\"title\"\\)}'\\)\n        print\\(f'    recommendation={eval_info.get\\(\"recommendation\"\\)} overall={eval_info.get\\(\"overall_score\"\\)}'\\)\n        print\\(f'    keywords={idea.get\\(\"keywords\"\\)}'\\)\n        print\\(f'    referenced_papers={idea.get\\(\"referenced_papers\"\\)}'\\)\n\nasyncio.run\\(main\\(\\)\\)\nPY)",
